# secrets
.env
# outputs
results/
*.log
# python
__pycache__/
*.pyc
.venv/
venv/

# 원본 리소스 zip 번들
*.zip

# 원본 대형 지명 파일(별도 전달) — 저장소에는 안 올림
data/raw/*.csv
data/raw/*.json

# 방언 지식 리소스 정제 결과 (네이버 사전/문법서 파생물 — 라이선스상 커밋 금지)
data/dialect_kb/
archive/v1_retrieval/data/dialect_kb/

# 방언성 표지 손목록 (AI-Hub 코퍼스/사전 파생 — 데이터 번들과 함께 별도 배포; 스크립트로 재현 가능)
docs/dialect_markers*.csv
archive/v1_retrieval/docs/dialect_markers*.csv

# AI-Hub 코퍼스에서 추출한 방언 어휘 빈도표 (재배포 제외)
docs/dialect_vocab_aihub.csv
archive/v1_retrieval/docs/dialect_vocab_aihub.csv

# 방언 코퍼스 (AI-Hub 등 외부 데이터 — 저장소 밖 별도 배포)
dialect_corpus/

# 방언학 논문 PDF (CC BY-NC-ND 등 — 재배포 금지. v2 문법 소스는 로컬에만 두고 사실만 인용)
*.pdf

# AI-Hub 파생 평가쌍 (저작권 — 재배포 금지, 스크립트로 재현)
v2_graph/data/eval_pairs.jsonl
archive/v2_failed/data/eval_pairs.jsonl

# v1 악취 파생 테스트셋 (생성물 — 스크립트로 재현)
v2_graph/data/eval_odor.jsonl
archive/v2_failed/data/eval_odor.jsonl

# 현재 KG 연구의 로컬 어휘 스냅샷 (네이버 방언 사전 파생, 재배포 금지)
sources/gyeongsang/lexical/gyeongsang_vocab.json

# 실패한 v2의 로컬 서버 점검 파일에는 임시 접근 자격증명이 포함될 수 있음
archive/v2_failed/scratch/

# 로컬 모델 연결 테스트: 실제 게이트웨이 인증 토큰 포함
/test.py

# 상세 에이전트 실행 로그/프로세스 파일은 로컬 보존 (완료 receipt는 추적)
current_kg/claims/v3/background_run/*.events.jsonl
current_kg/claims/v3/background_run/*.stderr
current_kg/claims/v3/background_run/*.lock
