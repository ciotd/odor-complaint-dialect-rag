      "assertions": [
        {
          "id": "JO2018-B001-C003.a",
          "kind": "historical_account",
          "target_refs": [
            "JO2018-B001-C003.usage"
          ],
          "content": {
            "source_locator": "PDF18 / 인쇄 6: 글아이- 지시 부정 기원",
