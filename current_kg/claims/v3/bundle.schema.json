{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim extraction bundle v3 draft",
  "description": "문헌 공통 첫 추출용 구조 계약. 출처 적격성과 페이지 상한은 registry에서 검증. content/value/properties의 내부 의미별 구조는 아직 확장 영역.",
  "type": "object",
  "properties": {
    "format_version": {
      "const": "3.0-draft.1"
    },
    "status": {
      "const": "extraction_draft"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      },
      "minItems": 0
    }
  },
  "required": [
    "format_version",
    "status",
    "entities",
    "evidence",
    "claims",
    "policies"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "eq"
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "feature": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": [
            "op",
            "target",
            "feature",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "Usage",
            "Construction",
            "Form"
          ]
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "properties"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "pdf_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source_statement",
            "reported_attestation"
          ]
        }
      },
      "required": [
        "id",
        "source_id",
        "pdf_pages",
        "locator",
        "excerpt",
        "kind"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "accepted_example",
            "rejected_example",
            "allowed_variants",
            "conditional_correspondence",
            "restricted_input_example",
            "regional_prevalence",
            "variant_usage_context",
            "general_combination",
            "attested_form",
            "scoped_inventory",
            "reported_emergence",
            "expression_alternatives",
            "paired_source_examples",
            "conditioned_realization",
            "regional_variant",
            "scope_caveat",
            "tentative_realization",
            "prosodic_contrast",
            "coexisting_endings",
            "pronunciation_variant",
            "historical_account"
          ]
        },
        "target_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "content": {
          "type": "object"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/condition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "target_refs",
        "content",
        "condition"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "region",
            "utterance_period",
            "usage_context",
            "speaker_generation"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "source_statement",
            "source_context",
            "not_established"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "dimension",
        "value",
        "basis",
        "evidence_refs",
        "missing_reason"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "exception_to",
            "distribution_context",
            "same_form_observed",
            "usage_change_relative_to",
            "qualifies"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "source_statement",
            "extractor_comparison"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "target",
        "basis",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "format": {
          "const": "user_accepted"
        },
        "linguistic_truth": {
          "const": "not_human_verified"
        },
        "extraction": {
          "const": "draft"
        }
      },
      "required": [
        "format",
        "linguistic_truth",
        "extraction"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "target_profile": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "primary",
            "secondary",
            "undetermined"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "decided_on": {
          "type": "string",
          "minLength": 10
        },
        "not_a_grammatical_claim": {
          "const": true
        }
      },
      "required": [
        "id",
        "applies_to",
        "target_profile",
        "priority",
        "rationale",
        "decided_by",
        "decided_on",
        "not_a_grammatical_claim"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "enum": [
            "grammatical_assertion",
            "attestation"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "source_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "target_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "minItems": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          },
          "minItems": 3
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "id",
        "record_type",
        "categories",
        "source_terms",
        "target_refs",
        "assertions",
        "evidence_refs",
        "annotations",
        "relations",
        "gaps",
        "review"
      ],
      "additionalProperties": false
    }
  }
}
