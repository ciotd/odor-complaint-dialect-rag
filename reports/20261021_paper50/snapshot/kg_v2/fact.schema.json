{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded KG v2 authored facts",
  "type": "object",
  "required": [
    "source_id",
    "facts"
  ],
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source_pattern",
          "target_pattern",
          "functions",
          "conditions",
          "constraints",
          "scope",
          "evidence",
          "claim_status",
          "usability",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 5
          },
          "type": {
            "enum": [
              "lexical_mapping",
              "inflection",
              "ending",
              "construction",
              "particle",
              "phonology",
              "usage",
              "constraint",
              "context"
            ]
          },
          "source_pattern": {
            "type": "object",
            "required": [
              "text",
              "domain",
              "lemma",
              "sense",
              "features"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "enum": [
                  "standard",
                  "dialect",
                  "shared",
                  "metalinguistic"
                ]
              },
              "lemma": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sense": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "features": {
                "type": "object"
              }
            }
          },
          "target_pattern": {
            "type": "object",
            "required": [
              "text",
              "domain",
              "lemma",
              "sense",
              "features"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "enum": [
                  "standard",
                  "dialect",
                  "shared",
                  "metalinguistic"
                ]
              },
              "lemma": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sense": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "features": {
                "type": "object"
              }
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "owner",
                "field",
                "op",
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "owner": {
                  "enum": [
                    "input",
                    "candidate",
                    "target",
                    "context"
                  ]
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "eq",
                    "in",
                    "not_in",
                    "exists"
                  ]
                },
                "value": {},
                "basis": {
                  "enum": [
                    "explicit",
                    "analyst_interpretation"
                  ]
                }
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "require",
                    "exclude",
                    "scope",
                    "uncertainty"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "scope": {
            "type": "object",
            "required": [
              "regions",
              "speech_levels",
              "registers",
              "period",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "regions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "speech_levels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "registers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "period": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "note": {
                "type": "string"
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "pdf_page",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 700
                }
              }
            }
          },
          "claim_status": {
            "enum": [
              "source_generalization",
              "attested_form",
              "attested_example",
              "author_hypothesis",
              "secondary_report",
              "analyst_interpretation",
              "negative_example"
            ]
          },
          "usability": {
            "enum": [
              "candidate",
              "reference_only",
              "blocked"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
